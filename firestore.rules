rules_version = '2'; service cloud.firestore { match /databases/{database}/documents {
 function signedIn() { return request.auth != null; }
 function myEmail() { return request.auth.token.email.lower(); }
 function isOwner() { return signedIn() && myEmail() == 'diaamagdy4112000@gmail.com' && request.auth.token.email_verified == true; }
 function isStaff() { return isOwner() || (signedIn() && request.auth.token.email_verified == true && exists(/databases/$(database)/documents/config/staff) && myEmail() in get(/databases/$(database)/documents/config/staff).data.admins); }
 function approved() { return signedIn() && exists(/databases/$(database)/documents/students/$(request.auth.uid)) && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.status == 'approved'; }
 match /config/public { allow read: if signedIn(); allow write: if isOwner(); }
 match /config/staff { allow read: if isStaff(); allow write: if isOwner(); }
 match /students/{uid} {
  allow read: if isStaff() || (signedIn() && request.auth.uid == uid);
  allow create: if isStaff() || (signedIn() && request.auth.uid == uid && request.resource.data.status == 'pending' && !('levels' in request.resource.data));
  allow update: if isStaff() || (signedIn() && request.auth.uid == uid && request.resource.data.status == resource.data.status && request.resource.data.get('levels', null) == resource.data.get('levels', null));
  allow delete: if isOwner(); }
 match /scores/{id} { allow read: if isStaff() || approved(); allow create, update: if approved() && request.resource.data.uid == request.auth.uid; allow delete: if isOwner(); } } }
